{
  "expo": {
    "scheme": "acme",
    "name": "tilt-guess",
    "slug": "tilt-guess",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tiltguess.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/tiltguess.png",
      "resizeMode": "contain",
      "backgroundColor": "#eee0cb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.tiltguess"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/tiltguess.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.tiltguess"
    },
    "web": {
      "favicon": "./assets/tiltguess.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sensors",
        {
          "motionPermission": "TiltGuess benötigt Zugriff auf Bewegungsdaten, um Kipp-Gesten im Spiel zu erkennen."
        }
      ]
    ]
  }
}
