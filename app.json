{
  "expo": {
    "scheme": "acme",
    "name": "tilt-guess",
    "slug": "tilt-guess",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tiltguess.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/tiltguess.png",
      "resizeMode": "contain",
      "backgroundColor": "#eee0cb"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/tiltguess.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/tiltguess.png"
    },
    "plugins": ["expo-router"]
  }
}
